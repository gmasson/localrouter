# =====================================================================
# LocalRouter — variaveis de ambiente de exemplo
# Copie para data/.env e preencha com suas chaves reais.
# O config.php le data/.env via parse_ini_file ANTES de qualquer define()
# usar getenv('X') ?: ''. Variavel de ambiente real (painel/shell) sempre
# vence — .env so preenche o que estiver vazio.
# NUNCA commite o data/.env real — apenas este .env.example.
# =====================================================================

# --- Cloudflare Workers AI ------------------------------------------
# ID da conta Cloudflare (necessario no caminho da URL do provedor).
CF_ACCOUNT_ID=

# --- Chaves de provedores OpenAI-compatible --------------------------
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_KEY=
GEMINI_API_KEY=
SILICONFLOW_KEY=
XAI_API_KEY=

# --- Chave do dialeto Anthropic --------------------------------------
ANTHROPIC_API_KEY=

# =====================================================================
# LISTAS (sintaxe parse_ini_file)
# =====================================================================
# Variaveis que o config.php le como lista (GATEWAY_KEYS) aceitam duas
# sintaxes neste .env. Use a que preferir; ambas viram array no PHP.
#
# Forma 1 — indices explicitos (recomendada, ordem garantida):
#   GATEWAY_KEYS[]="sk-lr-aaaa"
#   GATEWAY_KEYS[]="sk-lr-bbbb"
#   GATEWAY_KEYS[]="sk-lr-cccc"
#
# Forma 2 — string unica separada por virgula (simples, sem espacos):
#   GATEWAY_KEYS="sk-lr-aaaa,sk-lr-bbbb,sk-lr-cccc"
#
# Observacoes:
#   - Aspas duplas sao obrigatorias quando o valor tem caracteres especiais.
#   - Variavel de ambiente real (painel/shell) SEMPRE vence o .env.
#   - Para adicionar uma chave nova sem editar o .env, exporte no shell:
#       export GATEWAY_KEYS[]="sk-lr-nova"
#     ou defina no painel do provedor de deploy (Cloudflare Pages, etc.).
# =====================================================================