# =====================================================================
# LocalRouter — variáveis de ambiente de exemplo
# Copie para data/.env e preencha com suas chaves reais.
# O config.php lê data/.env via env('X'): a função lê o ambiente real
# (painel/shell/Docker) primeiro e, se estiver vazio, cai para este
# arquivo. Variável de ambiente real sempre vence — .env só preenche o
# que estiver vazio.
# NUNCA commite o data/.env real — apenas este .env.example.
# =====================================================================

# --- Chave do PRÓPRIO gateway ---------------------------------------
# Chave que SEUS apps enviam em Authorization: Bearer <chave>.
# Gere uma com: php index.php genkey
LR_GATEWAY_KEY="sk-lr-troque-esta-chave"


# --- Provedores ------------------------------------------------------
# Deixar em branco não quebra nada: o provedor só entra na rotação depois
# de ser cadastrado em PROVIDERS.

# OpenRouter (https://openrouter.ai/)
OPENROUTER_KEY=""

# NVIDIA (https://build.nvidia.com/) — providers.php soma até 4 contas
NVIDIA_API_KEY=""

# OPENCODE (https://opencode.ai/) — providers.php soma até 3 contas
OPENCODE_KEY=""

# ANTHROPIC (https://platform.claude.com/)
ANTHROPIC_API_KEY=""

# OrcaRouter (https://orcarouter.ai/) — providers.php soma até 2 contas
ORCAROUTER_KEY=""

# Modal (serverless, https://modal.com/) — um app por conta
MODAL_KEY=""

# --- Provedores do catálogo extra (providers-extra.php.example) -------
# As variáveis abaixo correspondem aos provedores que NÃO vêm no providers.php
# de fábrica. Estão declaradas em providers-extra.php.example: copie a
# linha do provedor desejado para dentro do return [...] do providers.php
# (na raiz) e preencha a chave aqui. Deixar em branco não quebra nada —
# o provedor só entra na rotação depois de cadastrado em PROVIDERS.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# GROQ (https://groq.com/)
GROQ_API_KEY=""

# Cerebras (https://api.cerebras.net)
CEREBRAS_API_KEY=""

# SiliconFlow (https://siliconflow.cn/api)
SILICONFLOW_KEY=""

# XAI (https://api.x.ai)
XAI_API_KEY=""

# Mistral (https://api.mistral.ai)
MISTRAL_API_KEY=""

# Hugging Face (https://huggingface.co/models)
HF_TOKEN=""

# Ollama Cloud (https://ollama.com/)
OLLAMA_KEY=""

# Vercel AI Gateway (https://vercel.com/ai-gateway)
VERCEL_AI_KEY=""

# Cloudflare Workers AI — exige o id da conta no caminho da URL do provedor
CF_ACCOUNT_ID=""
CF_API_TOKEN=""

# OpenAI oficial (https://platform.openai.com/)
OPENAI_API_KEY=""

# Fireworks (https://fireworks.ai/)
FIREWORKS_API_KEY=""

# Nebius (https://nebius.com/)
NEBIUS_API_KEY=""

# Novita (https://novita.ai/)
NOVITA_API_KEY=""

# Z AI / BigModel (https://bigmodel.cn/)
ZAI_API_KEY=""