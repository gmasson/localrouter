# LocalRouter — configuração Apache da raiz do domínio
# Testado em Apache 2.4. Blocos <IfModule> são ignorados com segurança quando
# o módulo não existe, então o arquivo não derruba o site em hospedagem limitada.

# ---------------------------------------------------------------------------
# 1. Sem listagem de diretório
#    Sem isto, um acesso a / pode expor localrouter.log e a pasta data/.
#    Options -Indexes desliga o mod_autoindex; IndexIgnore é uma segunda
#    tranca que esconde tudo caso o módulo esteja ausente ou AllowOverride
#    restrinja apenas parte das diretivas.
# ---------------------------------------------------------------------------
Options -Indexes
IndexIgnore *
<IfModule mod_autoindex.c>
    IndexOptions -FancyIndexing -HTMLTable
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------------
    # 2. Preservar o cabeçalho Authorization
    #    Em PHP rodando como CGI/FastCGI (comum em hospedagem compartilhada)
    #    o Apache descarta o Authorization e toda chamada vira 401. Esta
    #    regra o repassa como variável de ambiente antes de qualquer outra.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # -----------------------------------------------------------------------
    # 3. HTTPS obrigatório
    #    Chaves de API trafegam neste endpoint em todo request. HTTP puro as
    #    entrega em texto claro para qualquer intermediário da rede.
    #    O index.php tem a mesma regra (REQUIRE_HTTPS) como defesa em
    #    profundidade, caso o .htaccess não seja processado.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # -----------------------------------------------------------------------
    # 4. Rastreadores bloqueados por nome
    #    A lista é nominal de propósito. Um filtro genérico por "bot" no
    #    User-Agent derrubaria integrações legítimas que se identificam assim.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|ClaudeBot|Claude-Web|anthropic-ai|Google-Extended|Googlebot|Bingbot|Applebot|Amazonbot|Bytespider|PetalBot|YandexBot|Baiduspider|DuckDuckBot|facebookexternalhit|Twitterbot|AhrefsBot|SemrushBot|MJ12bot|DotBot|DataForSeoBot|Screaming\ Frog) [NC]
    RewriteRule ^ - [F,L]

    # -----------------------------------------------------------------------
    # 5. Métodos aceitos
    #    O router só usa GET, POST e OPTIONS. O resto é recusado antes do PHP.
    # -----------------------------------------------------------------------
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|OPTIONS)$
    RewriteRule ^ - [F,L]

    # -----------------------------------------------------------------------
    # 6. Arquivos internos fora do alcance da web
    #    src/ e config.php nunca são servidos diretamente. Cada um deles
    #    também morre sozinho se executado sem o bootstrap (guard interno),
    #    então esta regra é a primeira de duas trancas.
    # -----------------------------------------------------------------------
    RewriteRule ^src(/|$) - [F,L]
    RewriteRule ^config\.php$ - [F,L]
    # Catálogos na raiz: contêm chaves de API e ids de modelo; nunca servidos.
    RewriteRule ^providers\.php$ - [F,L]
    RewriteRule ^models\.php$ - [F,L]
    # data/ guarda estado (cooldown/rate limit) e logs; nunca servido.
    RewriteRule ^data(/|$) - [F,L]

    # -----------------------------------------------------------------------
    # 7. Roteamento
    #    Qualquer caminho que não seja um arquivo real cai no index.php, o que
    #    permite /chat/completions e /models como URLs limpas na raiz.
    # -----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # -----------------------------------------------------------------------
    # 8. Cabeçalhos de resposta
    #    X-Robots-Tag é o que realmente tira a pasta dos índices: robots.txt
    #    só é lido na raiz do domínio e não alcança subpastas.
    # -----------------------------------------------------------------------
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# 9. Arquivos que nunca podem ser servidos
#    localrouter.log guarda hosts dos provedores e histórico de falhas; data/
#    guarda o estado de cooldown e rate limit (protegida também por um
#    .htaccess próprio que o index.php cria dentro dela) e as métricas em
#    JSON (metrics.json). As extensões de banco ficam na lista por
#    segurança: se você apontar um LOG_FILE ou STATE_FILE para .db no
#    futuro, ele já nasce protegido.
# ---------------------------------------------------------------------------
<FilesMatch "\.(log|md|json|bak|sql|env|ini|txt|lock|db|sqlite|sqlite-shm|sqlite-wal)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
